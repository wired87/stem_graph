# GitHub personal access token (repo scope)
GITHUB_TOKEN=ghp_your_token_here

# GitHub owner (user or organization)
GITHUB_OWNER=your-github-username

# Private repo for product/executable (GitHub API push)
GITHUB_EXECUTABLE_REPO=cnvmaster-executable

# Private repo for full CNVMaster project (git commit + push)
GITHUB_PROJECT_REPO=cnvmaster-private

# Target branch for both publishers
GITHUB_BRANCH=main

# Git author used by publish_project
GIT_USER_NAME=CNVMaster Admin
GIT_USER_EMAIL=admin@example.com

# Optional: override executable source path (relative to admin/)
EXECUTABLE_SOURCE_DIR=../product/executable

# Optional: commit messages
EXECUTABLE_COMMIT_MESSAGE=Publish executable via GitHub API
PROJECT_COMMIT_MESSAGE=Publish CNVMaster project with auth and .env
