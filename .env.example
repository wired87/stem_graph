POSTGRES_DB=stemgraph
POSTGRES_USER=stemgraph
POSTGRES_PASSWORD=stemgraph-local
POSTGRES_PORT=5432
STEMCNV_MEMORY_LIMIT=6700m
STEMCNV_MEMORY_SWAP_LIMIT=10g
STEMCNV_WORKFLOW_MEMORY_MB=6500
# Control-plane Docker operations time out after five minutes. The asynchronous
# scientific workflow itself is not killed while it is making progress.
STEMCNV_DOCKER_TIMEOUT=300
# Portable host bind paths; relative paths are resolved beside compose.yaml.
STEMCNV_RUN_ROOT_HOST=./.runtime/stemcnv-runs
STEMCNV_EXAMPLE_DATA_HOST=./stemcnv-example-data
# Paste your personal Codex invite URL from the in-product referral offer here.
# The fallback Codex link does not award referral benefits.
CODEX_REFERRAL_URL=
